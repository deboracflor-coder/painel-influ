# Variáveis SÓ para os testes automatizados (CI e máquina local).
# Nenhum valor aqui é credencial real: os endereços apontam para o servidor de
# teste que tests/api/integracoes.test.ts sobe na porta 54399.
META_APP_ID=app-de-teste
META_APP_SECRET=segredo-de-teste
META_GRAPH_VERSION=v26.0
META_GRAPH_URL=http://host.docker.internal:54399/graph
META_DIALOG_URL=http://host.docker.internal:54399/dialog
GOOGLE_CLIENT_ID=cliente-de-teste
GOOGLE_CLIENT_SECRET=segredo-de-teste
GOOGLE_AUTH_URL=http://host.docker.internal:54399/google/auth
GOOGLE_TOKEN_URL=http://host.docker.internal:54399/google/token
GOOGLE_REVOKE_URL=http://host.docker.internal:54399/google/revoke
YOUTUBE_DATA_URL=http://host.docker.internal:54399/yt
YOUTUBE_ANALYTICS_URL=http://host.docker.internal:54399/yta
APP_URL=http://127.0.0.1:5173
OAUTH_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/oauth-callback
SYNC_CRON_SECRET=segredo-do-cron-de-teste
SHEETS_API_URL=http://host.docker.internal:54399/sheets
