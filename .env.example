# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings > Environment Variables).
# Nunca coloque estes valores no código, no chat ou em arquivos enviados ao GitHub.

# Supabase (Project Settings > API). Sem estas duas, o site abre a demonstração com dados fictícios.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: só no servidor
SUPABASE_SERVICE_ROLE_KEY=

# E-mail de quem administra o painel (vira dona no primeiro login)
OWNER_EMAIL=
# Endereço público do site, ex.: https://painel-influ.vercel.app
NEXT_PUBLIC_SITE_URL=
# Texto aleatório longo para assinar o retorno das conexões (ex.: saída de `openssl rand -hex 32`)
OAUTH_STATE_SECRET=

# Meta for Developers (Instagram + Facebook)
META_APP_ID=
META_APP_SECRET=
# TikTok for Developers
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Google Cloud (YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
